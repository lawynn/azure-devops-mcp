{
  "name": "@lawynn/azure-devops-mcp",
  "version": "0.1.0",
  "description": "Azure DevOps MCP server with explicit, repository-aware multi-account credential routing.",
  "mcpName": "io.github.lawynn/azure-devops-mcp",
  "type": "module",
  "bin": {
    "azure-devops-mcp": "plugin/server/index.js"
  },
  "files": ["plugin", "README.md", "LICENSE", "docs", "examples", "server.json"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "check:bundle": "node scripts/build.mjs --check",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawynn/azure-devops-mcp.git"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "overrides": {
    "@azure/msal-node": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@azure/identity": "4.13.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "esbuild": "0.28.2",
    "supports-color": "8.1.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
